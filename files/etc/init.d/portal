#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
  relay=$(cat /etc/portal/relay.conf 2>/dev/null)
  [ -z "$relay" ] && relay="http://176.111.37.5:39811"
  country=$(cat /etc/portal/country.conf 2>/dev/null)
  [ -z "$country" ] && country="AM"
  csv=$(grep -v '^#' /etc/portal/proxy-bypass.txt 2>/dev/null | grep -v '^$' | tr '\n' ',' | sed 's/,$//')
  procd_open_instance portal
  procd_set_param command /bin/sh -c "cd /etc/portal && exec ./opera-proxy -country $country -proxy '$relay' -bind-address 0.0.0.0:18080 -server-selection first -verbosity 20 -proxy-bypass '$csv'"
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
