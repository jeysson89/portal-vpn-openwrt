#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

# The policy must be (re)applied only after portal-tun exists, so the init
# script runs a supervisor loop that waits for the device (see portaltun-start.sh).
start_service() {
  procd_open_instance portaltun
  procd_set_param command /bin/sh /etc/portal/portaltun-start.sh
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 0
  procd_set_param stderr 0
  procd_close_instance
}
